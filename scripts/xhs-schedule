#!/bin/bash
# 批量暂停 / 恢复 xhs + ximalaya 的 launchd 定时任务。
# 只动 StartCalendarInterval 类任务，常驻服务（xhschrome / cdpproxy）永不触碰。
#
# ⛔ 必须从 ~/.local/bin/ 调用，不要直接跑仓库里这份（2026-08-18 定）。
#
# 实测现象：8/16 改完风控降频后 pause 了任务，8/17 00:30 的 resume 失败，报
#     /bin/bash: .../scripts/xhs-schedule: Operation not permitted
# 9 个定时任务全部停摆，日志止于 8/16，两天零产出，没有任何报错被人看到。
#
# 已排除的原因：**不是卷的 noexec** —— /Volumes/datacenter 挂载选项只有
# nodev/nosuid/noowners，而且从交互式终端跑这个脚本一切正常。
#
# 确切机制没查实（可能是后台上下文缺完全磁盘访问，也可能是凌晨外挂卷尚未就绪），
# 但有一个对照事实很清楚：**9 个 plist 一直能正常跑**，而它们的写法是
#     /opt/homebrew/bin/python3  /Volumes/.../launchd_runner.py  <子脚本>
# —— 解释器在本地卷，外挂卷上的文件只是**参数**。出问题的是本脚本这种
# 「直接 exec 外挂卷上的可执行文件」。
#
# 所以修法不依赖根因：把它装到本地卷，从 ~/.local/bin/ 调，两种解释都绕开了。
#
# 用法：
#   bash scripts/xhs-schedule install   # 装/更新到 ~/.local/bin/（改完这份就要跑一次）
#   xhs-schedule status | pause | resume

set -uo pipefail

JOBS=(
  com.eric.xhsaudit
  com.eric.xhsbrief
  com.eric.xhscollect
  com.eric.xhsdata
  com.eric.xhshealth
  com.eric.xhsprobe
  com.eric.xhspublish
  com.eric.xhstriage
  com.eric.xhswrite
  com.eric.ximalaya.daily
)

AGENTS="$HOME/Library/LaunchAgents"
BIN="$HOME/.local/bin/xhs-schedule"
LOG="$HOME/Library/Logs/xhs/schedule-toggle.log"
mkdir -p "$(dirname "$LOG")"

stamp() { date "+%Y-%m-%d %H:%M:%S"; }

case "${1:-}" in
  install)
    mkdir -p "$(dirname "$BIN")"
    cp "$0" "$BIN" && chmod +x "$BIN"
    echo "✅ 已安装到 $BIN"
    echo "   以后一律用 xhs-schedule {status|pause|resume}，别直接跑仓库里那份"
    exit 0
    ;;
  pause)
    for j in "${JOBS[@]}"; do
      launchctl bootout "gui/$UID/$j" 2>/dev/null
      echo "$(stamp) pause $j" >>"$LOG"
    done
    ;;
  resume)
    for j in "${JOBS[@]}"; do
      launchctl bootstrap "gui/$UID" "$AGENTS/$j.plist" 2>/dev/null
      echo "$(stamp) resume $j" >>"$LOG"
    done
    ;;
  status)
    for j in "${JOBS[@]}"; do
      # ⛔ 别用 `launchctl list | grep`：2026-08-18 实测它会漏报已加载的任务
      # （xhswrite / xhspublish 明明在 list 里，判据却说「已暂停」）。
      # `launchctl list <label>` 直接查单个服务，加载了返回 0，没加载返回非 0。
      if launchctl list "$j" >/dev/null 2>&1; then
        echo "已加载   $j"
      else
        echo "已暂停   $j"
      fi
    done
    exit 0
    ;;
  *)
    echo "用法: xhs-schedule {install|pause|resume|status}" >&2
    exit 1
    ;;
esac

"$0" status
