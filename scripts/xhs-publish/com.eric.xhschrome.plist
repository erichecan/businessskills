<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.eric.xhschrome</string>

    <!-- 自动化专用 Chrome 实例。为什么必须单独起一个：

         Chrome 150 起，**没有用命令行显式指定 ‑‑remote-debugging-port 的实例**，
         其调试端口只是在 LISTEN 而不应答 —— 要人去 chrome://inspect/#remote-debugging
         勾一次「Allow remote debugging」，而且那是**会话级授权，会过期**。
         2026-08-06 实测：授权失效后已建连接还能续一会儿、新连接一律被拒，
         代理一重启就 connected:false，采集/发布/数据回收全线静默失败。
         靠人去勾一个会过期的开关，「无人值守」就是假的。

         命令行起的实例不需要那个开关，HTTP 端点（/json/list、/json/version）也正常应答。

         用独立 ‑‑user-data-dir：不碰你日常那个 Chrome 的 profile、书签、登录态和窗口。
         代价是小红书要在这个 profile 里**单独登录一次**，之后 cookie 就留在里面。

         端口用 9333 而不是 9222：9222 被日常 Chrome 占着（虽然它不应答）。

         ⛔ 2026-09-17 同步：这份文件一直停在 Google Chrome + ~/.xhs-chrome-profile，
         而线上从 2026-08-21 起就换成了 **Chromium + ~/.xhs-chromium-profile
         + --load-extension**（见 CLAUDE.md「联网抓取规则」）。仓库这份漂了将近一个月，
         照它重装等于把故障装回来：没有 --load-extension，opencli 的 Browser Bridge
         就连不上，采集/探测/发布/数据回收全部静默返回空 —— 09-12~09-17 的采集
         连续 15 轮 0 条，就是扩展没连上（不是登录态问题）。 -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/eric/.chromium-org/Chromium.app/Contents/MacOS/Chromium</string>
        <string>--remote-debugging-port=9333</string>
        <string>--user-data-dir=/Users/eric/.xhs-chromium-profile</string>
        <string>--remote-allow-origins=http://127.0.0.1:9333</string>
        <string>--no-first-run</string>
        <string>--no-default-browser-check</string>
        <!-- opencli 的 Browser Bridge 扩展。⛔ 漏了这行 = 扩展连不上，
             而所有依赖 opencli 的链路（采集/探测/发布/数据回收）都会静默返回空。 -->
        <string>--load-extension=/Users/eric/.xhs-chromium-opencli-ext</string>
        <!-- 不要加 ‑‑headless：小红书创作平台对无头浏览器有风控，且预填后的页面
             还需要能被人看见（自动选时间失败时得有人接手）。 -->
    </array>

    <key>RunAtLoad</key>
    <true/>
    <!-- 关掉就拉起来。这是整条链的地基，不能靠人记得开。 -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/eric/Library/Logs/xhs/launchd-com.eric.xhschrome.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/eric/Library/Logs/xhs/launchd-com.eric.xhschrome.log</string>
</dict>
</plist>
