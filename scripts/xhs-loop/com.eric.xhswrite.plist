<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.eric.xhswrite</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/python3</string>
		<string>/Volumes/datacenter/04-eric/AIcoding/businessskills/scripts/launchd_runner.py</string>
		<string>xhs-loop/refine_loop.py</string>
		<string>--rework</string>
		<string>2</string>
		<string>--count</string>
		<string>2</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/tmp/xhswrite.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/xhswrite.log</string>
	<key>StartCalendarInterval</key>
	<array>
		<!-- 2026-08-08 由一天四次（04:30/09:30/14:30/19:30）改为两次。
		     理由：「返工2篇＋新稿2篇」一次产 4 篇，四次 ＝ 理论 16 篇/天，
		     而实际发布配额是 3 篇/天（auto_publish DAILY_QUOTA）—— 产能是消耗的 5 倍，
		     多出来的全部变成 claude -p 调用和积压的待审稿。
		     loop日志 里 8 份 "You've hit your session limit" 就是这么撞出来的。
		     留 04:30（夜里额度最松）和 14:30（离 22:00 发布有足够返工时间）。 -->
		<dict>
			<key>Hour</key>
			<integer>4</integer>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>14</integer>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
	</array>
</dict>
</plist>
