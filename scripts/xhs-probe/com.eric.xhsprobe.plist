<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.eric.xhsprobe</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Volumes/datacenter/04-eric/AIcoding/businessskills/scripts/launchd_runner.py</string>
        <string>xhs-probe/daily_probe.sh</string>
    </array>
    <!-- 2026-08-11：02:30 / 08:30 / 14:30 / 20:30 → 10:00 / 14:30 / 18:30（Eric 定）。
         这条链里的 auto_analyze.py 会调 claude -p，属于消耗 usage 的任务，
         所以三个触发点全部收进 10:00–19:00；14:30 是原有时段，保留不动。

         从 4 次减到 3 次：probe.py 有反封控硬上限 MAX_KEYWORDS_PER_RUN=5，
         一次最多 5 个词，3 次 = 15 个词/天，远够喂 4 篇/天的写稿产能。
         夜里那两次（02:30 / 20:30）本来就是撞额度空转的重灾区 ——
         08-10 这一路 40 次调用全部 0 产出。

         10:00 这次为当天 11:00 的写稿备料；18:30 这次为明天备料
         （19:00 之后不再有消耗 usage 的任务）。 -->
    <key>StartCalendarInterval</key>
    <!-- 2026-08-16 降频错峰（Eric 定）。这天主站被风控：opencli 搜索连常见词都返回空数组，创作者中心却正常。原排班搜索类每天 7 轮、最小间隔仅 0.5 小时（18:30 probe 紧接 19:00 collect）。改为 5 轮、最小间隔 2.5 小时。⛔ 同日多轮的命中率实测并没有递减（run1 31.7% 到 run6 43.4%），所以这是拿采集量换存活的真实取舍，不是砍掉没用的部分。脚本侧另加了开跑前 0-15 分钟随机错峰，抵消 launchd 掐整点的规律性。 -->
    <array>
        <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/eric/Library/Logs/xhs/launchd-com.eric.xhsprobe.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/eric/Library/Logs/xhs/launchd-com.eric.xhsprobe.log</string>
</dict>
</plist>
