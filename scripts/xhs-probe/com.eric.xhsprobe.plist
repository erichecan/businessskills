<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.eric.xhsprobe</string>
    <!-- 2026-08-03：从只跑 probe.py 改成跑整条链（probe → auto_analyze → backfill）。
         原来第 2 层要在对话里手动跑 skill，探测数据攒着没人分析，词库的「已验证」
         全靠人工标。limit 也从 5 提到 10 —— 探测队列有 267 个词待探。 -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Volumes/datacenter/04-eric/AIcoding/businessskills/scripts/xhs-probe/daily_probe.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
    </array>
    <key>StandardOutPath</key>
    <string>/tmp/xhsprobe.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/xhsprobe.log</string>
</dict>
</plist>
