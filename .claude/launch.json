{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true,
      "cwd": "app"
    },
    {
      "name": "workflow",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.js"],
      "port": 3210,
      "autoPort": false,
      "cwd": "workflow"
    },
    {
      "name": "xhs-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8810"],
      "port": 8810,
      "autoPort": false,
      "cwd": "xhs"
    },
    {
      "name": "preview-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8830"],
      "port": 8830,
      "autoPort": false,
      "cwd": "preview"
    }
  ]
}
